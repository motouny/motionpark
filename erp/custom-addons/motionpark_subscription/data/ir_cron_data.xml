<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_motionpark_generate_recurring" model="ir.cron">
        <field name="name">Motion Park: Generate Recurring Subscription Orders</field>
        <field name="model_id" ref="model_motionpark_subscription"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_recurring()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_motionpark_expire_subscriptions" model="ir.cron">
        <field name="name">Motion Park: Expire Subscriptions Past End Date</field>
        <field name="model_id" ref="model_motionpark_subscription"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_subscriptions()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
