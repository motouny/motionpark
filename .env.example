# Motion Park — Environment Template
# Copy to .env and fill real values. NEVER commit .env.

APP_URL=https://motion-park.com
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000

# PostgreSQL (app database)
DATABASE_CONNECTION=Host=127.0.0.1;Port=5432;Database=motionpark;Username=motionpark_app;Password=CHANGE_ME

# Redis (cache, locks, rate-limit, queue state)
REDIS_CONNECTION=127.0.0.1:6379,password=,abortConnect=false

# JWT
JWT_SECRET=CHANGE_ME_64+_chars
JWT_ISSUER=motionpark
JWT_AUDIENCE=motionpark
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# Odoo (backend-only — Angular must never see these)
ODOO_URL=http://127.0.0.1:8069
ODOO_DATABASE=motionpark_odoo
ODOO_USERNAME=admin
ODOO_PASSWORD=CHANGE_ME
ODOO_XMLRPC_TIMEOUT_SECONDS=30
ODOO_XMLRPC_RETRY_COUNT=3

# SMTP (leave empty to mark live sending blocked)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ENABLE_SSL=true

# Payments (no fake success: empty => 402 PAYMENT_CREDENTIALS_REQUIRED)
PAYMENT_PROVIDER=
PAYMENT_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Media
MEDIA_STORAGE_PATH=/var/www/motionpark/storage/media
MEDIA_MAX_MB=10

# Feature flags
ENABLE_SWAGGER=false
SEED_DEMO_DATA=false
