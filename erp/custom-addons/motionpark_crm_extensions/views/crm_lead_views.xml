<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_motionpark" model="ir.ui.view">
        <field name="name">crm.lead.form.motionpark</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="motionpark" string="Motion Park">
                    <group>
                        <field name="motionpark_lead_type"/>
                        <field name="motionpark_branch_id"/>
                        <field name="motionpark_activity_id"/>
                        <field name="external_reference"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
