<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="motionpark_booking_view_list" model="ir.ui.view">
        <field name="name">motionpark.booking.list</field>
        <field name="model">motionpark.booking</field>
        <field name="arch" type="xml">
            <list string="Bookings">
                <field name="external_uuid"/>
                <field name="schedule_date"/>
                <field name="start_time"/>
                <field name="branch_id"/>
                <field name="activity_id"/>
                <field name="coach_name"/>
                <field name="customer_partner_id"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="motionpark_booking_view_form" model="ir.ui.view">
        <field name="name">motionpark.booking.form</field>
        <field name="model">motionpark.booking</field>
        <field name="arch" type="xml">
            <form string="Booking">
                <sheet>
                    <group>
                        <group string="Schedule">
                            <field name="schedule_date"/>
                            <field name="start_time"/>
                            <field name="status"/>
                        </group>
                        <group string="Session">
                            <field name="branch_id"/>
                            <field name="activity_id"/>
                            <field name="coach_name"/>
                            <field name="customer_partner_id"/>
                            <field name="external_uuid"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="motionpark_booking_view_search" model="ir.ui.view">
        <field name="name">motionpark.booking.search</field>
        <field name="model">motionpark.booking</field>
        <field name="arch" type="xml">
            <search string="Bookings">
                <field name="external_uuid"/>
                <field name="coach_name"/>
                <field name="customer_partner_id"/>
                <field name="branch_id"/>
                <field name="activity_id"/>
                <separator/>
                <filter string="Confirmed" name="confirmed" domain="[('status', '=', 'confirmed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('status', '=', 'cancelled')]"/>
                <group>
                    <filter string="Branch" name="group_by_branch" context="{'group_by': 'branch_id'}"/>
                    <filter string="Activity" name="group_by_activity" context="{'group_by': 'activity_id'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="motionpark_booking_action" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">motionpark.booking</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="motionpark_booking_view_search"/>
    </record>
</odoo>
