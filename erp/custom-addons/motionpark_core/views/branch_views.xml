<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="motionpark_branch_view_list" model="ir.ui.view">
        <field name="name">motionpark.branch.list</field>
        <field name="model">motionpark.branch</field>
        <field name="arch" type="xml">
            <list string="Branches">
                <field name="name"/>
                <field name="name_ar"/>
                <field name="city"/>
                <field name="phone"/>
                <field name="whatsapp"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="motionpark_branch_view_form" model="ir.ui.view">
        <field name="name">motionpark.branch.form</field>
        <field name="model">motionpark.branch</field>
        <field name="arch" type="xml">
            <form string="Branch">
                <sheet>
                    <group>
                        <group string="General">
                            <field name="name"/>
                            <field name="name_ar"/>
                            <field name="city"/>
                            <field name="active"/>
                        </group>
                        <group string="Contact">
                            <field name="phone"/>
                            <field name="whatsapp"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                    </group>
                    <group string="Address &amp; Hours">
                        <field name="address"/>
                        <field name="operating_hours"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="motionpark_branch_view_search" model="ir.ui.view">
        <field name="name">motionpark.branch.search</field>
        <field name="model">motionpark.branch</field>
        <field name="arch" type="xml">
            <search string="Branches">
                <field name="name"/>
                <field name="name_ar"/>
                <field name="city"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="motionpark_branch_action" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">motionpark.branch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="motionpark_branch_view_search"/>
    </record>
</odoo>
