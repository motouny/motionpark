<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="motionpark_payment_transaction_view_list" model="ir.ui.view">
        <field name="name">motionpark.payment.transaction.list</field>
        <field name="model">motionpark.payment.transaction</field>
        <field name="arch" type="xml">
            <list string="Payment Transactions">
                <field name="external_uuid"/>
                <field name="subscription_id"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="provider"/>
                <field name="status"/>
                <field name="reference"/>
            </list>
        </field>
    </record>

    <record id="motionpark_payment_transaction_view_form" model="ir.ui.view">
        <field name="name">motionpark.payment.transaction.form</field>
        <field name="model">motionpark.payment.transaction</field>
        <field name="arch" type="xml">
            <form string="Payment Transaction">
                <header>
                    <button name="action_mark_success" type="object" string="Mark Success" class="btn-primary" invisible="status == 'success'"/>
                    <button name="action_mark_failed" type="object" string="Mark Failed" invisible="status == 'failed'"/>
                    <field name="status" widget="statusbar" statusbar_visible="initiated,success,failed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Transaction">
                            <field name="external_uuid"/>
                            <field name="reference"/>
                            <field name="provider"/>
                            <field name="status"/>
                        </group>
                        <group string="Amount">
                            <field name="amount"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group string="Relations">
                        <field name="subscription_id"/>
                        <field name="partner_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="motionpark_payment_transaction_view_search" model="ir.ui.view">
        <field name="name">motionpark.payment.transaction.search</field>
        <field name="model">motionpark.payment.transaction</field>
        <field name="arch" type="xml">
            <search string="Payment Transactions">
                <field name="external_uuid"/>
                <field name="reference"/>
                <field name="subscription_id"/>
                <field name="partner_id"/>
                <separator/>
                <filter string="Success" name="success" domain="[('status', '=', 'success')]"/>
                <filter string="Failed" name="failed" domain="[('status', '=', 'failed')]"/>
            </search>
        </field>
    </record>

    <record id="motionpark_payment_transaction_action" model="ir.actions.act_window">
        <field name="name">Payment Transactions</field>
        <field name="res_model">motionpark.payment.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="motionpark_payment_transaction_view_search"/>
    </record>
</odoo>
