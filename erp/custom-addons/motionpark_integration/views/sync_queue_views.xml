<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="motionpark_sync_queue_view_list" model="ir.ui.view">
        <field name="name">motionpark.sync.queue.list</field>
        <field name="model">motionpark.sync.queue</field>
        <field name="arch" type="xml">
            <list string="Sync Queue">
                <field name="name"/>
                <field name="entity"/>
                <field name="status"/>
                <field name="attempts"/>
                <field name="next_attempt_at"/>
                <field name="transaction_id"/>
            </list>
        </field>
    </record>

    <record id="motionpark_sync_queue_view_form" model="ir.ui.view">
        <field name="name">motionpark.sync.queue.form</field>
        <field name="model">motionpark.sync.queue</field>
        <field name="arch" type="xml">
            <form string="Sync Queue">
                <sheet>
                    <group>
                        <group string="Job">
                            <field name="name"/>
                            <field name="entity"/>
                            <field name="transaction_id"/>
                            <field name="status"/>
                        </group>
                        <group string="Scheduling">
                            <field name="attempts"/>
                            <field name="next_attempt_at"/>
                        </group>
                    </group>
                    <group string="Payload">
                        <field name="payload"/>
                    </group>
                    <group string="Error">
                        <field name="last_error"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="motionpark_sync_queue_view_search" model="ir.ui.view">
        <field name="name">motionpark.sync.queue.search</field>
        <field name="model">motionpark.sync.queue</field>
        <field name="arch" type="xml">
            <search string="Sync Queue">
                <field name="entity"/>
                <field name="transaction_id"/>
                <separator/>
                <filter string="Pending" name="pending" domain="[('status', '=', 'pending')]"/>
                <filter string="Error" name="error" domain="[('status', '=', 'error')]"/>
                <filter string="Done" name="done" domain="[('status', '=', 'done')]"/>
            </search>
        </field>
    </record>

    <record id="motionpark_sync_queue_action" model="ir.actions.act_window">
        <field name="name">Sync Queue</field>
        <field name="res_model">motionpark.sync.queue</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="motionpark_sync_queue_view_search"/>
    </record>
</odoo>
