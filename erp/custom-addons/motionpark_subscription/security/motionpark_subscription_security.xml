<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="portal_motionpark_subscription_rule" model="ir.rule">
        <field name="name">Motion Park Subscription: portal users read own subscriptions</field>
        <field name="model_id" ref="model_motionpark_subscription"/>
        <field name="domain_force">['|', ('partner_id', '=', False), ('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
